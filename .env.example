# ================================================================
# Variables de entorno — Foresight Finanzas (solo frontend)
# Copia este archivo a .env.local (desarrollo) o configúralas en
# el dashboard de Vercel (producción). NO subir .env a git.
#
# NOTA: todas son públicas por diseño (quedan visibles en el bundle
# del navegador). NUNCA poner aquí la service_role key de Supabase.
# ================================================================

# Supabase — URL del proyecto y anon key (pública)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Sentry — DSN del proyecto (público) y entorno de reporte
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
