{
  "name": "foresight-finanzas",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Tus finanzas personales y de negocio, claras y en un solo lugar.",
  "scripts": {
    "dev": "vite",
    "dev:doppler": "doppler run -- vite",
